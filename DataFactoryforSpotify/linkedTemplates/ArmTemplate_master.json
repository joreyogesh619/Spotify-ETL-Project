{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DataFactoryforSpotify"
		},
		"AzureDataLakeStorageLinkConnection_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageLinkConnection'"
		},
		"AzureSqlDatabaseConnectionLink_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabaseConnectionLink'"
		},
		"AzureDataLakeStorageLinkConnection_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storageaccountspotify1.dfs.core.windows.net/"
		},
		"AzureSqlDatabaseConnectionLink_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifyproject-sqlserver.database.windows.net"
		},
		"AzureSqlDatabaseConnectionLink_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifyprojectdatabase"
		},
		"AzureSqlDatabaseConnectionLink_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "joreyogesh"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DataFactoryforSpotify_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorageLinkConnection_accountKey": {
						"value": "[parameters('AzureDataLakeStorageLinkConnection_accountKey')]"
					},
					"AzureSqlDatabaseConnectionLink_password": {
						"value": "[parameters('AzureSqlDatabaseConnectionLink_password')]"
					},
					"AzureDataLakeStorageLinkConnection_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageLinkConnection_properties_typeProperties_url')]"
					},
					"AzureSqlDatabaseConnectionLink_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabaseConnectionLink_properties_typeProperties_server')]"
					},
					"AzureSqlDatabaseConnectionLink_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabaseConnectionLink_properties_typeProperties_database')]"
					},
					"AzureSqlDatabaseConnectionLink_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabaseConnectionLink_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}